#!/bin/sh
# Pre-commit hook: runs Spotless formatter and static analysis on the backend.
# Install once with: cd backend && ./gradlew installGitHooks

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
BACKEND="$REPO_ROOT/backend"

# Capture the staged Java file list (NUL-delimited) BEFORE Spotless modifies
# the working tree, so we only re-stage files that were already in the index.
STAGED_JAVA_FILES="$(mktemp)"
trap 'rm -f "$STAGED_JAVA_FILES"' EXIT
git diff --cached --name-only -z -- '*.java' > "$STAGED_JAVA_FILES"

echo "--- pre-commit: Spotless ---"
(cd "$BACKEND" && ./gradlew spotlessApply --quiet)

# Re-stage any Java files that Spotless just reformatted.
if [ -s "$STAGED_JAVA_FILES" ]; then
  xargs -0 git add -- < "$STAGED_JAVA_FILES"
  echo "Spotless reformatted and re-staged:"
  tr '\0' '\n' < "$STAGED_JAVA_FILES" | sed 's/^/  /'
fi

echo "--- pre-commit: static analysis (warnings only) ---"
(cd "$BACKEND" && ./gradlew checkstyleMain pmdMain --quiet) || true

echo "--- pre-commit: done ---"
