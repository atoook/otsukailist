# PostgreSQL Database Configuration
POSTGRES_DB=otsukailist
POSTGRES_USER=otsukailist_user
POSTGRES_PASSWORD=otsukailist_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable
# Optional extra JDBC params. If set, start with '&' (example: &connectTimeout=5)
POSTGRES_PARAMS=

# Server Configuration
SERVER_PORT=8080
# CORS Settings
APP_CORS_ALLOWED_ORIGINS=https://your-production-domain.com,http://localhost:5173
