# PostgreSQL Database Configuration
POSTGRES_DB=otsukailist
POSTGRES_USER=otsukailist_user
POSTGRES_PASSWORD=otsukailist_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PARAMS=?sslmode=disable

# Server Configuration
SERVER_PORT=yourPort
# CORS Settings
APP_CORS_ALLOWED_ORIGINS=https://your-production-domain.com,http://localhost:devPort
